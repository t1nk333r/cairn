{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hsync.dev/schemas/native-protocol-v1.json",
  "title": "hsync native messaging protocol v1",
  "$defs": {
    "gitConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteUrl", "branch", "filePath"],
      "properties": {
        "remoteUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "branch": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 }
      }
    },
    "gitWriteInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteUrl", "branch", "filePath", "dataBase64", "expectedVersion"],
      "properties": {
        "remoteUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "branch": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 },
        "dataBase64": { "type": "string", "contentEncoding": "base64" },
        "expectedVersion": { "type": ["string", "null"] }
      }
    },
    "setSecretInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteUrl", "username", "token"],
      "properties": {
        "remoteUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "username": { "type": "string", "minLength": 1 },
        "token": { "type": "string", "minLength": 1, "maxLength": 16384 }
      }
    },
    "deleteSecretInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteUrl"],
      "properties": {
        "remoteUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "command"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "command": {
          "enum": ["hello", "testConnection", "readInventory", "writeInventory", "sync", "getStatus", "cancel", "setSecret", "deleteSecret"]
        },
        "payload": {}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "event"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string" },
        "event": { "enum": ["progress", "completed", "failed"] },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
