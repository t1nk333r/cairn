{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hsync.dev/schemas/native-protocol-v1.json",
  "title": "hsync native messaging protocol v1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "command"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "command": {
          "enum": ["hello", "testConnection", "readInventory", "writeInventory", "sync", "getStatus", "cancel", "setSecret", "deleteSecret"]
        },
        "payload": {}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "event"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string" },
        "event": { "enum": ["progress", "completed", "failed"] },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
