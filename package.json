{
  "name": "cairn",
  "version": "0.1.1",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "prepare": "wxt prepare",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:crx": "node scripts/pack-crx.mjs",
    "pack:xpi": "wxt zip -b firefox && mkdir -p dist && cp .output/cairn-$npm_package_version-firefox.zip dist/cairn-$npm_package_version.xpi",
    "sign:xpi": "bash scripts/sign-xpi.sh",
    "release:crx": "npm run pack:crx && gh release upload v$npm_package_version dist/cairn-$npm_package_version.crx --clobber",
    "update-manifest": "node scripts/update-manifest.mjs",
    "version": "node scripts/update-manifest.mjs && git add updates.json"
  },
  "//": "Add-on identity lives here so wxt.config.ts and scripts/*.mjs read one source. Changing geckoId or crxId strands every existing install: the browser treats the result as a different extension.",
  "cairn": {
    "geckoId": "cairn@t1nk333r.dev",
    "crxId": "bddeidknhkokohcgdkpgdmlppgfkblig",
    "strictMinVersion": "128.0",
    "updateManifestUrl": "https://raw.githubusercontent.com/t1nk333r/cairn/main/updates.json",
    "releaseDownloadBase": "https://github.com/t1nk333r/cairn/releases/download"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "crx3": "^2.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
